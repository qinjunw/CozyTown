{"arm":"F","content":"{\"schemaVersion\":4,\"operation\":\"invite\",\"planId\":\"sora-ren-fish-supply\",\"meetingId\":\"\",\"text\":\"Ren! I'm at the pond area and craving fresh carp. Meet me by the pond walk at 780 and we can talk fish and cooking. Terms look good to me.\"}","decisionId":"6862ca112cdf46599701a87fa8478725","providerCall":1,"request":1,"status":"content_recorded","step":1,"worldRunId":"c26a4e6fa1ff4ffc9f2d2a34e593f13a"}
