{"arm":"F","content":"{\"schemaVersion\":4,\"operation\":\"invite\",\"planId\":\"sora-ren-fish-supply\",\"meetingId\":\"\",\"text\":\"Ren! I'm by the pond—how about we meet at pond-walk to talk carp and recipes? I'll buy 1 carp for 25 coins.\"}","decisionId":"7beb1307696a42a98ab43b9b2934ee81","providerCall":1,"request":1,"status":"content_recorded","step":1,"worldRunId":"7b6dae05f8fa4063b35f8c37f7897e61"}
